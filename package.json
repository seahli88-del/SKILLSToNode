{
  "name": "@seahli/skill-pack",
  "version": "0.1.1",
  "description": "Reusable AI skill pack published from GitHub source.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/seahli88-del/SKILLSToNode.git"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./skills/*": "./.github/skills/*/SKILL.md"
  },
  "files": [
    "src",
    ".github/skills",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "node --check src/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
